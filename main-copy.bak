const { app, BrowserWindow, ipcMain, screen } = require('electron'); // Added 'screen'
const path = require('path');
const fs = require('fs');
const serve = require('electron-serve');

const loadURL = serve({ directory: 'dist' });

// --- DYNAMIC CONFIG LOGIC ---
let configData = {
    BASE_URL: "http://150.95.31.23:8030" 
};

function loadExternalConfig() {
    let configPath;
    if (process.env.NODE_ENV === 'development') {
        configPath = path.join(__dirname, 'config.json');
    } else {
        const isMac = process.platform === 'darwin';
        configPath = isMac
            ? path.join(process.resourcesPath, 'config.json')
            : path.join(path.dirname(app.getPath('exe')), 'config.json');
    }

    if (fs.existsSync(configPath)) {
        try {
            const raw = fs.readFileSync(configPath);
            const parsed = JSON.parse(raw);
            if (parsed.BASE_URL) {
                configData.BASE_URL = parsed.BASE_URL;
            }
        } catch (e) {
            console.error("❌ JSON Parse Error:", e);
        }
    }
}

// --- IPC HANDLERS ---

// 1. Get API URL
ipcMain.handle('get-base-url', () => {
    return configData.BASE_URL;
});

// 2. NEW: Get Screen Information for Dual Display
ipcMain.handle('get-screens', () => {
    const allDisplays = screen.getAllDisplays();
    const primaryId = screen.getPrimaryDisplay().id;
    
    return allDisplays.map(display => ({
        id: display.id,
        bounds: display.bounds, // Contains x, y, width, height
        isPrimary: display.id === primaryId
    }));
});

// 3. Get Printer List
ipcMain.handle('get-printers', async () => {
    const win = BrowserWindow.getAllWindows()[0];
    return await win.webContents.getPrintersAsync();
});



ipcMain.on('print-command', (event, payload) => {
    const { html, printerName, width = '80mm' } = payload;

    const widthMap = { 'A4': 800, 'A5': 580, '80mm': 302, '58mm': 219 };
    const windowWidth = widthMap[width] || 302;

    let printWindow = new BrowserWindow({
        show: true,
        width: windowWidth,
        height: 800, // Start smaller
        webPreferences: {
            nodeIntegration: false,
            contextIsolation: true
        }
    });
    // 2. Validate Printer Name
    // const availablePrinters = printWindow.webContents.getPrinters();
    // const printerExists = availablePrinters.some(p => p.name === printerName);

    // if (!printerExists && printerName) {
    //     console.warn(`⚠️ Printer "${printerName}" not found. Falling back to default.`);
    // }

    printWindow.loadURL('about:blank');

    printWindow.webContents.on('did-finish-load', () => {
        // Add a small CSS fix to the HTML to ensure it doesn't have huge margins
        const cssFix = `<style>body { margin: 0; padding: 0; width: ${width}; }</style>`;
        const finalHtml = cssFix + html;
        const escapedHtml = finalHtml.replace(/`/g, '\\`').replace(/\${/g, '\\${');

        printWindow.webContents.executeJavaScript(`
            document.open();
            document.write(\`${escapedHtml}\`);
            document.close();
            // This returns the actual height of the content back to Electron
            Math.max(document.body.scrollHeight, document.body.offsetHeight, document.documentElement.clientHeight, document.documentElement.scrollHeight, document.documentElement.offsetHeight);
        `).then((contentHeight) => {
            
            // Allow time for Lao fonts to "paint"
            setTimeout(() => {
                let printOptions = {
                    silent: true,
                    deviceName: printerName || '',
                    printBackground: true,
                    margins: { marginType: 'none' }, // Try 'custom' with 0 if 'none' fails
                };

                if (width === 'A4' || width === 'A5') {
                    printOptions.pageSize = width;
                } else {
                    // FIX: Use 'custom' size but let the height be calculated
                    // 1px roughly equals 264 microns in Electron's printing
                    printOptions.pageSize = {
                        width: (width === '58mm' ? 58000 : 80000),
                        height: (contentHeight * 264) + 10000 // Add small buffer
                    };
                }

                printWindow.webContents.print(printOptions, (success, failureReason) => {
                    if (!success) {
                        console.error('❌ Print Failed:', failureReason);
                    }
                    printWindow.close();
                });
            }, 1000); // 1 second is safer for dual-printer compatibility
        });
    });
});

