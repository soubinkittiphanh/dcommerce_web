{
  "name": "dcommerce-pos",
  "version": "26.3.2",
  "private": true,
  "description": "Lao Minimart/Restaurant Point of Sale System",
  "main": "main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start --hostname 0.0.0.0 --port ${PORT:-3333}",
    "generate": "nuxt generate",
    "electron:dev": "concurrently \"npm run dev\" \"cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run generate && electron-builder",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint": "npm run lint:js"
  },
  "build": {
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "mac": {
      "identity": null,
      "icon": "static/icon.icns"
    },
    "appId": "com.dcommerce.pos",
    "productName": "DCommerce POS",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "static/icon.ico",
      "uninstallerIcon": "static/icon.ico"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@nuxt/icon": "^1.14.0",
    "@nuxtjs/auth-next": "^5.0.0-1637745161.ea53f98",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/fontawesome": "^1.1.2",
    "@nuxtjs/svg": "^0.4.1",
    "@nuxtjs/toast": "^3.3.1",
    "@tillpos/xml-escpos-helper": "^0.2.7",
    "apexcharts": "^3.40.0",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.0",
    "core-js": "^3.45.1",
    "echarts": "^5.4.3",
    "electron-serve": "^1.1.0",
    "exceljs": "^4.4.0",
    "gantt-elastic": "^1.0.12",
    "gantt-schedule-timeline-calendar": "^3.35.2",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.11.5",
    "jspdf-invoice-template": "^1.4.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nfc-pcsc": "^0.8.1",
    "nuxt": "^2.18.1",
    "qrcode": "^1.5.3",
    "sweetalert2": "^11.23.0",
    "v-calendar": "^2.4.2",
    "vue-apexcharts": "^1.6.2",
    "vue-carousel-3d": "^1.0.1",
    "vue-echarts": "^6.6.1",
    "vue-feather-icons": "^5.1.0",
    "vue-sweetalert2": "^3.0.8",
    "vue-virtual-scroller": "^1.1.2",
    "vue-youtube": "^1.4.0",
    "vue2-datepicker": "^3.11.1",
    "vuedraggable": "^2.24.3",
    "vuelidate": "^0.7.7",
    "vuetify": "^2.6.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.16.5",
    "@nuxtjs/eslint-config": "^6.0.1",
    "@nuxtjs/eslint-module": "^3.0.2",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.0",
    "@nuxtjs/vuetify": "^1.12.3",
    "@electron/rebuild": "^3.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^25.0.0",
    "eslint": "^7.29.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-nuxt": "^2.0.0",
    "eslint-plugin-vue": "^7.20.0",
    "prettier": "^2.5.1"
  }
}
