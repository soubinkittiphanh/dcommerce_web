  margin: 0 0 15px 0;
  text-align: center;
  color: #333;
}

.print-item {
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px dotted #ccc;
}

.print-item:last-child {
  border-bottom: none;
}

.item-line {
  margin-bottom: 4px;
}

.item-main {
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  margin-bottom: 2px;
}

.item-name {
  color: #333;
}

.item-price {
  color: #000;
}

.item-details {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-left: 15px;
  color: #666;
}

.item-total {
  font-weight: bold;
  color: #000;
}

.item-notes {
  font-size: 11px;
